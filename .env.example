# Copy to .env for local development. Never commit .env.
# Base de datos propia (en el compose de vankoo-infra: risk-db-postgres, puerto 5435 en tu PC).
DATABASE_URL=postgresql+asyncpg://admin:password@localhost:5435/vankoo_risk_db_dev
DATABASE_ECHO=false
DOCS_ENABLED=true

# Kafka: localhost:9092 desde tu PC; kafka-broker:9094 dentro de Docker.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=risk-auction-assessment-v1
# latest a propósito: el tópico guarda todo para siempre y reprocesarlo re-calificaría subastas viejas.
KAFKA_AUTO_OFFSET_RESET=latest
KAFKA_CONSUMER_ENABLED=true
KAFKA_PRODUCER_ENABLED=true

# Investment directo, nunca por el gateway: el gateway no rutea /internal.
INVESTMENT_BASE_URL=http://localhost:8082
INVESTMENT_CONNECT_TIMEOUT=2
INVESTMENT_READ_TIMEOUT=5
INVESTMENT_DELIVERY_ENABLED=true

# Padrones de SUNAT: se refrescan solos al arrancar y cada día a las 04:00 de Lima.
# false si no quieres descargar el padrón (unos 400 MB) en tu PC; las subastas saldrán C.
REGISTRY_REFRESH_ENABLED=true
REGISTRY_REFRESH_HOUR=4

# Central de riesgos SIMULADA (calificación SBS inventada a partir del RUC, siempre la misma).
CREDIT_BUREAU_ENABLED=true

# Noticias negativas del pagador con IA (OpenAI). Sin clave, el paso se salta.
OPENAI_API_KEY=
NEWS_ENABLED=true
NEWS_MODEL=gpt-6-luna
NEWS_MAX_SEARCHES=5
NEWS_CACHE_DAYS=7

# Certificado verde de la MYPE, leído con la misma clave de OpenAI. Sin clave, queda sin decidir.
GREEN_ENABLED=true
GREEN_MODEL=gpt-6-luna
# El bucket de Profile visto desde este servicio: localhost:9100 desde tu PC, minio:9000 en Docker.
GREEN_DOCUMENTS_BASE_URL=http://localhost:9100/vankoo-profile-documents
GREEN_MAX_BYTES=10485760

# KYC de la MYPE: la ficha RUC firmada por SUNAT, descargada con GREEN_DOCUMENTS_BASE_URL.
KYC_MAX_BYTES=5242880
# PARCHE TEMPORAL para demos: la CA de `uv run python -m verification demo-ca`. Nunca en producción.
# KYC_DEMO_CA_PATH=demo-kyc/ca.pem
